{
  "name": "inreply-monorepo",
  "private": true,
  "description": "Turn inbound email replies into resumable AI conversations.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "~10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "~10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "~17.2.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "~7.0.2",
    "typescript-eslint": "~8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js}": "eslint --fix",
    "*.{json,md,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.1",
      "yaml": ">=2.8.3",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "vite": ">=6.4.3 <7",
      "esbuild": ">=0.28.1",
      "brace-expansion": ">=5.0.8",
      "@eslint/plugin-kit": ">=0.3.4 <0.4.0"
    }
  }
}
