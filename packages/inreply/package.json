{
  "name": "inreply",
  "version": "0.0.1",
  "description": "Turn inbound email replies into resumable AI conversations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "email",
    "inbound",
    "webhook",
    "conversation",
    "ai",
    "agent",
    "reply",
    "thread",
    "resend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inreply/inreply.git",
    "directory": "packages/inreply"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "html-to-text": "^9.0.5"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@vitest/coverage-v8": "^2.1.8",
    "email-reply-parser": "^2.3.9",
    "tsup": "^8.3.5",
    "vitest": "^2.1.8"
  }
}
