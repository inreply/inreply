{
  "name": "@inreply/resend",
  "version": "0.1.0",
  "description": "Resend provider for InReply - turn inbound Resend webhooks into resumable AI conversations.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "resend",
    "email",
    "inbound",
    "webhook",
    "conversation",
    "ai",
    "inreply"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inreply/inreply.git",
    "directory": "packages/resend"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "inreply": "workspace:^",
    "resend": "^6.17.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "^8.5.1",
    "vitest": "^3.2.6"
  },
  "homepage": "https://github.com/inreply/inreply#readme",
  "bugs": {
    "url": "https://github.com/inreply/inreply/issues"
  },
  "author": "Dip Dhameliya <dipdhameliya2001@gmail.com>"
}
